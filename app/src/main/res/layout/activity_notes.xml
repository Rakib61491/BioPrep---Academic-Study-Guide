<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutNotesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bio_surface">

    <!-- Fullscreen Stitch Background Atmosphere -->
    <ImageView
        android:id="@+id/ivNotesBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_stitch_biology"
        android:alpha="0.25"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnNotesBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/bio_primary_container" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="জীববিজ্ঞান (HSC Biology)"
                        android:textColor="@color/bio_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notes Notebook • ContentProvider CRUD"
                        android:textColor="@color/bio_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Search Bar Simulation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_glow"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_notification"
                    android:tint="@color/bio_outline" />

                <EditText
                    android:id="@+id/etSearchNotes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search your biology notes..."
                    android:inputType="text"
                    android:textColor="@color/bio_on_surface"
                    android:textColorHint="@color/bio_outline"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Prominent Glowing CTA: Add Note Form Container -->
            <LinearLayout
                android:id="@+id/cardAddNoteForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_glow"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Add New Biology Note"
                    android:textColor="@color/bio_primary_container"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lab Topic 10: ContentProvider insert() &amp; query()"
                    android:textColor="@color/bio_on_surface_variant"
                    android:textSize="11sp" />

                <!-- Note Title Input -->
                <EditText
                    android:id="@+id/etNoteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_white"
                    android:hint="Note Title (e.g. Calvin Cycle Steps)"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/bio_card_text_dark"
                    android:textColorHint="@color/bio_outline"
                    android:textSize="14sp" />

                <!-- Note Details Input -->
                <EditText
                    android:id="@+id/etNoteDetails"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_white"
                    android:gravity="top"
                    android:hint="Note Content (e.g. Carbon fixation, RuBisCO enzyme...)"
                    android:padding="12dp"
                    android:textColor="@color/bio_card_text_dark"
                    android:textColorHint="@color/bio_outline"
                    android:textSize="13sp" />

                <!-- Action Buttons: Add Details & Show Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- android:onClick="onClickAddDetails" specified in topic 10 -->
                    <Button
                        android:id="@+id/btnAddDetails"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/bio_primary_container"
                        android:onClick="onClickAddDetails"
                        android:text="Add Note (Insert)"
                        android:textAllCaps="false"
                        android:textColor="@color/bio_on_primary_container"
                        android:textStyle="bold" />

                    <!-- android:onClick="onClickShowDetails" specified in topic 10 -->
                    <Button
                        android:id="@+id/btnShowDetails"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/bio_surface_container_highest"
                        android:onClick="onClickShowDetails"
                        android:text="Query Notes"
                        android:textAllCaps="false"
                        android:textColor="@color/bio_primary"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Categories Horizontal Bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Categories"
                android:textColor="@color/bio_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_cyan"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="উদ্ভিদ শারীরতত্ত্ব"
                        android:textColor="@color/bio_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_emerald"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="কোষ বিভাজন"
                        android:textColor="@color/bio_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_amber"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="কোষ ও এর গঠন"
                        android:textColor="@color/bio_tertiary_container"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_cyan"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="জিনতত্ত্ব ও বিবর্তন"
                        android:textColor="@color/bio_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Notes List Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Your Notes (Provider Records)"
                android:textColor="@color/bio_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Container for Notes rendered dynamically from ContentResolver query -->
            <LinearLayout
                android:id="@+id/layoutNotesListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Raw ContentProvider Query Result Output Text -->
            <TextView
                android:id="@+id/tvQueryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:textColor="@color/bio_card_text_dark"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Bottom space before scroll ends -->
            <View
                android:layout_width="match_parent"
                android:layout_height="72dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Dock (Fixed at Bottom, matching Stitch Design) -->
    <LinearLayout
        android:id="@+id/bottomNavNotes"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/bio_surface_container_low"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tab 1: Home -->
        <LinearLayout
            android:id="@+id/navTabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/bio_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 2: Study -->
        <LinearLayout
            android:id="@+id/navTabStudy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Study"
                android:textColor="@color/bio_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 3: Saved (ACTIVE in Notes) -->
        <LinearLayout
            android:id="@+id/navTabSaved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_cyan"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔖"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved"
                android:textColor="@color/bio_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 4: Profile -->
        <LinearLayout
            android:id="@+id/navTabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/bio_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

