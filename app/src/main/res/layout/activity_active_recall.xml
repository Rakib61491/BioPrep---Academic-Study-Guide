<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutActiveRecallRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bio_surface">

    <!-- Fullscreen Botanical Microscopic Background matching Active Recall.jpeg -->
    <ImageView
        android:id="@+id/ivActiveRecallBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_stitch_biology"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#22001713"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable Content Container -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Rounded Mint/Teal Banner Header matching Active Recall.jpeg -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bannerRecallHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_banner_teal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <!-- Small Back Button and Logo at Top Left -->
                <LinearLayout
                    android:id="@+id/layoutRecallTopLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/btnRecallBack"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/bio_banner_header_text" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="BioPrep App Logo"
                        android:src="@drawable/app_logo" />
                </LinearLayout>

                <!-- Centered Title -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnRecallOptions"
                    app:layout_constraintStart_toEndOf="@id/btnRecallBack"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvRecallHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Active Recall:\nChapter 4 - Bioenergetics"
                        android:textColor="@color/bio_banner_header_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Three dots options button -->
                <ImageView
                    android:id="@+id/btnRecallOptions"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Options"
                    android:src="@drawable/ic_more_vert_clean"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/bio_banner_header_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Question Counter & Progress Bar -->
            <TextView
                android:id="@+id/tvQuestionProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="Question 3 of 10"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbRecallProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="10"
                android:progress="3"
                android:progressDrawable="@drawable/progress_bar_cyan" />

            <!-- Main High-Contrast Question Card (Clinical White Card) -->
            <LinearLayout
                android:id="@+id/cardQuestionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Question Text -->
                <TextView
                    android:id="@+id/tvRecallPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="Q3: Describe the steps of the Calvin Cycle without looking. Try to recall the main inputs, outputs, and enzyme involved."
                    android:textColor="@color/bio_card_text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Hidden Bengali Prompt helper if needed -->
                <TextView
                    android:id="@+id/tvRecallPromptBn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ক্যালভিন চক্রের প্রধান ধাপ ও এনজাইম স্মরণ করুন"
                    android:textColor="@color/bio_card_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Reveal Answer Button Inside Card -->
                <Button
                    android:id="@+id/btnToggleAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill_emerald"
                    android:text="Reveal Answer"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Model Answer Container (Hidden until revealed) -->
                <LinearLayout
                    android:id="@+id/layoutAnswerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#F0FDF4"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Model Answer (Active Recall Key):"
                        android:textColor="#166534"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModelAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="1. Carbon Fixation: RuBisCO fixes CO2 with RuBP (5C) forming 3-PGA.\n2. Reduction: 3-PGA converts to G3P using ATP and NADPH.\n3. RuBP Regeneration: G3P molecules regenerate RuBP using ATP."
                        android:textColor="#14532D"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvRecallKeywords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Keywords: RuBisCO • RuBP • 3-PGA • G3P • ATP • NADPH"
                        android:textColor="#15803D"
                        android:textSize="11sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <!-- Feedback Section: How well did you know it? -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Feedback: How well did you know it?"
                    android:textColor="@color/bio_card_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Rating Pills Row matching Active Recall.jpeg -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Again -->
                    <Button
                        android:id="@+id/btnRecallAgain"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_soft_teal"
                        android:text="😟 Again"
                        android:textAllCaps="false"
                        android:textColor="@color/bio_banner_header_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <!-- Good -->
                    <Button
                        android:id="@+id/btnRecallGood"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_soft_teal"
                        android:text="😊 Good"
                        android:textAllCaps="false"
                        android:textColor="@color/bio_banner_header_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <!-- Easy -->
                    <Button
                        android:id="@+id/btnRecallEasy"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_soft_teal"
                        android:text="😉 Easy"
                        android:textAllCaps="false"
                        android:textColor="@color/bio_banner_header_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <!-- Input Box for Student's Self-Recall Notes -->
                <EditText
                    android:id="@+id/etActiveRecallText"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:gravity="top|start"
                    android:hint="Type or speak your recall thoughts here..."
                    android:padding="12dp"
                    android:textColor="@color/bio_card_text_dark"
                    android:textColorHint="@color/bio_card_text_muted"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Bottom Action Button: Show Answer matching Active Recall.jpeg -->
            <Button
                android:id="@+id/btnShowAnswerBottom"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_emerald"
                android:text="Show Answer"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Navigation Controls (Prev / Next) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRecallPrev"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark_teal"
                    android:text="◀ Previous"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnRecallNext"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark_teal"
                    android:text="Next Drill ▶"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Chapter Tag for Lab 08 Topic 5 Dynamic Addition Hook -->
            <TextView
                android:id="@+id/tvChapterTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Spacer before scroll ends -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Dock matching Active Recall.jpeg -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_bottom_nav_dock"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: Home -->
        <LinearLayout
            android:id="@+id/navTabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_nav"
                app:tint="@color/bio_nav_inactive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="@color/bio_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 2: Study (Active) -->
        <LinearLayout
            android:id="@+id/navTabStudy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_study_nav"
                app:tint="@color/bio_nav_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Study"
                android:textColor="@color/bio_nav_active"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 3: Saved -->
        <LinearLayout
            android:id="@+id/navTabSaved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_saved_nav" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Saved"
                android:textColor="@color/bio_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Profile -->
        <LinearLayout
            android:id="@+id/navTabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile_nav" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="@color/bio_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
