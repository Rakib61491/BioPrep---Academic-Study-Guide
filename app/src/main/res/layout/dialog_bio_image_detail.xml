<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark_teal"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header bar with category and close button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/btnDialogClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Large Image Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#0D2E25"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivDialogImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Zoological Specimen Large View"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/pbDialogImageLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/bio_mint_accent" />
    </androidx.cardview.widget.CardView>

    <!-- Animal Names & Attribution -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDialogCommonName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Common Name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogScientificName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scientific Name"
            android:textColor="@color/bio_mint_accent"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tvDialogPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Location"
            android:textColor="@color/bio_card_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDialogAttribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Attribution"
            android:textColor="@color/bio_card_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDialogDismiss"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill_emerald"
        android:text="Close Preview"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>

