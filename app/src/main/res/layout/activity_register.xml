<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRegisterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bio_surface">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_stitch_biology"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#22001713"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollRegister"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:isScrollContainer="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- App Logo Icon -->
            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:contentDescription="BioPrep App Logo"
                android:src="@drawable/app_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Join BioPrep HSC"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Create your personalized study profile"
                android:textColor="@color/bio_mint_accent"
                android:textSize="13sp" />

            <!-- Card for Register Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Student Account"
                    android:textColor="@color/bio_card_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Full Name Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Full Name"
                    android:textColor="@color/bio_card_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRegisterName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_dark_teal"
                    android:hint="e.g. Rahat Ahmed"
                    android:inputType="textPersonName"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/bio_on_surface_variant"
                    android:textSize="14sp" />

                <!-- Email Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Email Address"
                    android:textColor="@color/bio_card_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRegisterEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_dark_teal"
                    android:hint="student@example.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/bio_on_surface_variant"
                    android:textSize="14sp" />

                <!-- Password Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Password (Min. 6 characters)"
                    android:textColor="@color/bio_card_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/etRegisterPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_dark_teal"
                        android:hint="Create password"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="46dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/bio_on_surface_variant"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnToggleRegisterPassword"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Show/Hide Password"
                        android:src="@drawable/ic_search_clean"
                        app:tint="@color/bio_on_surface_variant" />
                </FrameLayout>

                <!-- Confirm Password Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Confirm Password"
                    android:textColor="@color/bio_card_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/etRegisterConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_dark_teal"
                        android:hint="Re-enter password"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="46dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/bio_on_surface_variant"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnToggleRegisterConfirmPassword"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Show/Hide Password"
                        android:src="@drawable/ic_search_clean"
                        app:tint="@color/bio_on_surface_variant" />
                </FrameLayout>

                <!-- Register Button -->
                <Button
                    android:id="@+id/btnRegisterSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pill_cyan"
                    android:text="Create Account"
                    android:textAllCaps="false"
                    android:textColor="#0A382C"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>

            <!-- Go to Sign In Link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvGoToSignIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign In"
                    android:textColor="@color/bio_mint_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

