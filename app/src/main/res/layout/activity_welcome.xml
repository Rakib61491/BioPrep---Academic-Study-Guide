<?xml version="1.0" encoding="utf-8"?>
<!--
    Lab 08 Topic 7: Relative Layout in Android
    Matches Stitch UI Design: "Loading Screen" (ID: 5e7d8e45d1a747eb843fd7a0f5d2c67d)
    Demonstrates attributes:
    - layout_alignParentTop
    - layout_alignParentBottom
    - layout_alignParentRight
    - layout_alignParentLeft
    - layout_centerHorizontal
    - layout_centerVertical
    - layout_above
    - layout_below
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutWelcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#031510">

    <!-- Fullscreen Bioluminescent Cellular Background Art matching Loading Screen.jpeg -->
    <ImageView
        android:id="@+id/ivWelcomeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_stitch_biology" />

    <!-- Subtle gradient overlay for typography readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33001713" />

    <!-- Topic 7: Top Left Status/Back Anchor using layout_alignParentTop and layout_alignParentLeft -->
    <ImageButton
        android:id="@+id/btnWelcomeBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Exit"
        android:src="@drawable/ic_arrow_back"
        android:tint="#7DFFE9" />

    <!-- Topic 7: Top Right Indicator with layout_alignParentTop and layout_alignParentRight -->
    <TextView
        android:id="@+id/tvWelcomeBadgeRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:text="HSC 2026"
        android:textColor="#25F4DB"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Center Content Block: layout_centerVertical="true" and layout_centerHorizontal="true" -->
    <LinearLayout
        android:id="@+id/layoutCenterBranding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Bioluminescent Circular Logo Emblem from Stitch -->
        <ImageView
            android:id="@+id/imgWelcomeLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="HSC Biology Emblem"
            android:src="@drawable/ic_bio_emblem" />

        <!-- App Title Typography verbatim from Stitch -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#22F3E0"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="14"
            android:text="HSC Biology"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Subtitles: Warrior Edition & Active Study App -->
        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#4EEDB8"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:text="Warrior Edition"
            android:textColor="#25F4DB"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWelcomeTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Active Study App"
            android:textColor="#55EDC2"
            android:textSize="15sp" />

        <!-- Circular Neon Loading Spinner from Stitch -->
        <ProgressBar
            android:id="@+id/spinnerWelcome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/spinner_neon_ring" />

        <!-- Microcopy Loading Text Lines (Animated in Java) -->
        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prepping your study desk..."
            android:textColor="#7CFBD4"
            android:textSize="15sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tvLoadingSubStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Loading Bio-Universe..."
            android:textColor="#55EDC2"
            android:textSize="13sp" />

        <!-- Glowing Horizontal Progress Bar (Fills 0% to 100% during auto-start) -->
        <ProgressBar
            android:id="@+id/pbWelcomeAutoProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="260dp"
            android:layout_height="8dp"
            android:max="100"
            android:progress="15"
            android:progressDrawable="@drawable/progress_bar_cyan" />

    </LinearLayout>

    <!-- Topic 7: Footer anchored with layout_alignParentBottom and layout_centerHorizontal -->
    <LinearLayout
        android:id="@+id/layoutWelcomeFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Active Recall Slogan -->
        <TextView
            android:id="@+id/tvFooterSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Master Biology through Active Recall &amp; Practice"
            android:textColor="#A7F3D0"
            android:textSize="13sp" />

        <!-- HSC Brand Mark & Attribution -->
        <TextView
            android:id="@+id/tvFooterBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="HSC"
            android:textColor="#3BE7C0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFooterPowered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered by Active Study"
            android:textColor="#6EE7B7"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
