<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardChapterItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Chapter Number Circle Badge -->
    <TextView
        android:id="@+id/tvChapterNumber"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_chip_emerald"
        android:gravity="center"
        android:text="01"
        android:textColor="#065F46"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Chapter Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChapterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bio_card_text_dark"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChapterSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="🎯 50+ MCQs • 10 Mins"
            android:textColor="@color/bio_card_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Practice / Study Action Button -->
    <TextView
        android:id="@+id/btnChapterPractice"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_pill_emerald"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Practice"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
