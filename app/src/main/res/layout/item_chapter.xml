<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Chapter Number Circle Badge -->
    <TextView
        android:id="@+id/tvChapterNumber"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_chip_emerald"
        android:gravity="center"
        android:text="01"
        android:textColor="#065F46"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Chapter Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChapterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bio_card_text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChapterSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="🎯 25 MCQs available"
            android:textColor="@color/bio_card_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Practice Button -->
    <TextView
        android:id="@+id/btnChapterPractice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#059669"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="Practice >"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
