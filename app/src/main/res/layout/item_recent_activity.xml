<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRecentItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:elevation="3dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Activity Type Emoji Icon in Dark Squircle -->
    <TextView
        android:id="@+id/tvItemRecentIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_card_dark_teal"
        android:gravity="center"
        android:text="🌱"
        android:textSize="20sp" />

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemRecentType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Recall"
            android:textColor="@color/bio_card_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemRecentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Chapter 1: Cell and its Structure"
            android:textColor="@color/bio_card_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemRecentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="3 mins ago"
            android:textColor="@color/bio_card_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Chevron -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Open Activity"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/bio_card_text_muted" />

</LinearLayout>

