<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCustomNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bio_surface_container"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgNotifIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_notification"
        android:tint="@color/bio_primary_container" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BioPrep Study Alert"
            android:textColor="@color/bio_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNotifDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Your active recall session milestone has been reached!"
            android:textColor="@color/bio_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>

