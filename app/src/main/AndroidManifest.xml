<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for Academic Study Guide & Attachment features -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BioPrepAcademicStudyGuide">

        <!-- Screen 1: Loading Screen (Stitch UI 5e7d8e45d1a747eb843fd7a0f5d2c67d & Topic 7 RelativeLayout) -->
        <activity
            android:name=".activities.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Terms and Conditions Agreement Screen -->
        <activity
            android:name=".activities.AgreementActivity"
            android:exported="false" />

        <!-- Screen 2: Home Dashboard (Stitch UI 42f918aa14ed4adaa9691586e244cea1 & Topics 2, 4, 6, 8, 9, 11, 12) -->
        <activity
            android:name=".activities.HomeActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Screen 3: Active Recall (Stitch UI 8e0b6be08b3540ec9378b2c2e92d7abc & Topic 5 Dynamic Layouts) -->
        <activity
            android:name=".activities.ActiveRecallActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Screen 4: Notes (Stitch UI 692a226658e74006ab34491ea36b157a & Topic 10 ContentProvider Client) -->
        <activity
            android:name=".activities.NotesActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Screen 5: Bangladeshi Resources Library (Stitch UI cedda05495b643c9a6166c01c5b1f0c7 & Topic 3 Implicit Intents) -->
        <activity
            android:name=".activities.ResourcesActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Screen 6: Flashcards (Stitch UI 629273b7864d428ba53d656d62c9e39f & Lab Manual Experiments A-D) -->
        <activity
            android:name=".activities.FlashcardsActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Screen 7: Exam Practice Hub (Stitch UI 2a7bc4f212844e18a9a7062a2d9e5377) -->
        <activity
            android:name=".activities.ChapterActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Screen 8: Exam Practice MCQ (Stitch UI 83149009bc5a421c902eae2d555996b4) -->
        <activity
            android:name=".activities.QuizActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Screen 9: Daily Goal & Analytics (Stitch UI f2da6fcd1eb14abc8f2ab5e649c85f74) -->
        <activity
            android:name=".activities.AnalyticsActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Screen 10: Saved Items (Stitch UI e888790cdd02497dba1b515e3036d0a6) -->
        <activity
            android:name=".activities.SavedItemsActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Screen 11: My Profile (Stitch UI 71d77bd7d6c14a188f6ba5eede1863d9) -->
        <activity
            android:name=".activities.ProfileActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Topic 11: AfterNotification Activity ("new Intent(this, AfterNotification.class)") -->
        <activity
            android:name=".activities.AfterNotification"
            android:exported="false" />

        <!-- Add Note Screen -->
        <activity
            android:name=".activities.AddNoteActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- View Note Screen -->
        <activity
            android:name=".activities.ViewNoteActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Native PDF Reader Screen -->
        <activity
            android:name=".activities.PdfReaderActivity"
            android:exported="false" />

        <!-- Resource Destination Detail Screen -->
        <activity
            android:name=".activities.ResourceDetailActivity"
            android:exported="false" />

        <!-- Exam Practice Results Screen -->
        <activity
            android:name=".activities.QuizResultActivity"
            android:exported="false" />

        <!-- Review Needed Chapters Screen -->
        <activity
            android:name=".activities.ReviewNeededActivity"
            android:exported="false" />

        <!-- Help & Support Screen -->
        <activity
            android:name=".activities.HelpSupportActivity"
            android:exported="false" />

        <!-- Authentication Screens -->
        <activity
            android:name=".activities.SignInActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".activities.RegisterActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".activities.SettingsActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".activities.RecentActivitiesActivity"
            android:exported="false" />

        <!-- Bound Study Timer Service -->
        <service
            android:name=".services.StudyTimerService"
            android:exported="false" />

        <!-- Topic 8: Services in Android with Example -->
        <service
            android:name=".services.BackgroundAudioService"
            android:exported="false" />
        <service
            android:name=".services.NewService"
            android:exported="false" />

        <!-- Topic 10: Content Provider in Android with Example -->
        <provider
            android:name=".providers.BioNotesProvider"
            android:authorities="com.example.bioprep.provider.notes"
            android:exported="false" />

        <!-- FileProvider for Note camera captures and private files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.bioprep.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Topic 9: Broadcast Receiver for Airplane Mode -->
        <receiver
            android:name=".receivers.AirplaneModeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.AIRPLANE_MODE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
